---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorLink from './AuthorLink.astro';
import FormattedDate from './FormattedDate.astro';
import { url } from '../utils/paths';
import { postLink } from '../utils/posts';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, authors, tags, publisher, lang, doi, archived } = post.data;
const link = postLink(post);
---

<article class:list={['blog-post-card', { 'is-external': link.external }]}>
    <div class="blog-content">
        <h2 class="blog-title">
            <a href={link.href} target={link.target} rel={link.rel}>
                {title}
                {link.external && <span class="external-arrow" aria-label="(external, opens in a new tab)">&nearr;</span>}
            </a>
        </h2>

        <div class="blog-meta">
            <FormattedDate date={pubDate} />

            {link.external && (
                <>
                    <span class="meta-divider">&bull;</span>
                    <span class="external-badge">&nearr; on {publisher}</span>
                </>
            )}
            {tags && tags.length > 0 && (
                <>
                    <span class="meta-divider">&bull;</span>
                    <span class="blog-tags" style="display: inline-flex; gap: 0.25rem;">
                        {tags.map((tag) => (
                            <a href={url(`/tags/${tag}`)} style="text-decoration: none; color: var(--color-accent); font-weight: 600;">#{tag}</a>
                        ))}
                    </span>
                </>
            )}

            {lang && (
                <>
                    <span class="meta-divider">&bull;</span>
                    <span class="lang-pill" title={`Written in ${lang}`}>{lang}</span>
                </>
            )}
        </div>

        {authors && authors.length > 0 && (
            <div class="blog-meta blog-authors">
                <span>By</span>
                {authors.map((authorId, i) => (
                    <span>
                        <AuthorLink nameOrSlug={authorId} />
                        {i < authors.length - 1 ? ', ' : ''}
                    </span>
                ))}
            </div>
        )}

        <p class="blog-desc">
            {description}
        </p>

        <div class="blog-actions">
            {link.external ? (
                <a href={link.href} target={link.target} rel={link.rel} class="read-more">Read on {publisher} &nearr;</a>
            ) : (
                <a href={link.href} class="read-more">Read Article &rarr;</a>
            )}
            {doi && <a href={`https://doi.org/${doi}`} target="_blank" rel="noopener" class="secondary-link">DOI</a>}
            {archived && <a href={archived} target="_blank" rel="noopener" class="secondary-link">Archived copy</a>}
        </div>
    </div>

    <a href={link.href} target={link.target} rel={link.rel} class="blog-thumb">
        {heroImage ? (
            <Image width={560} height={315} src={heroImage} alt={title} />
        ) : (
            <img src={url(`/blog/${post.id}.webp`)} alt={title} />
        )}
    </a>
</article>

<style>
    .blog-post-card {
        display: flex;
        gap: 2.5rem;
        align-items: flex-start;
        padding-bottom: 3rem;
        border-bottom: 1px solid var(--color-border);
    }
    .blog-post-card:last-child {
        border-bottom: none;
    }

    .blog-thumb {
        width: 280px;
        flex-shrink: 0;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: var(--shadow-md);
        aspect-ratio: 16/9;
        display: block;
        order: 2;
        align-self: flex-start;
    }
    .blog-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease, filter 0.3s ease;
    }
    .blog-post-card:hover .blog-thumb img {
        transform: scale(1.03);
        filter: brightness(1.05);
    }

    .blog-content {
        flex: 1;
        order: 1;
        padding-right: 1rem;
    }
    .blog-title {
        margin: -0.2rem 0 0.75rem 0;
        font-family: var(--font-serif);
        font-size: 1.75rem;
        line-height: 1.25;
        letter-spacing: -0.01em;
    }
    .blog-title a {
        color: var(--color-text-main);
        text-decoration: none;
        transition: color 0.2s;
    }
    .blog-title a:hover {
        color: var(--color-accent);
    }
    .blog-meta {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
    }
    .blog-authors {
        margin-top: -0.5rem;
    }
    .meta-divider {
        color: #ddd;
    }
    .blog-desc {
        margin: 0 0 1.5rem 0;
        color: var(--color-text-muted);
        line-height: 1.7;
        font-size: 1.05rem;
    }
    .blog-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem;
    }
    .read-more {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--color-accent);
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        transition: border-color 0.2s;
    }
    .read-more:hover {
        border-bottom-color: var(--color-accent);
    }
    .secondary-link {
        font-size: 0.85rem;
        color: var(--color-text-muted);
        text-decoration: underline dotted;
        text-underline-offset: 3px;
    }
    .secondary-link:hover {
        color: var(--color-accent);
    }

    /* External posts: an accent rule down the side, plus a publisher badge. */
    .is-external .blog-content {
        border-left: 3px dashed var(--color-accent);
        padding-left: 1.25rem;
    }
    .external-arrow {
        margin-left: 0.3em;
        font-size: 0.7em;
        color: var(--color-accent);
        vertical-align: super;
    }
    .external-badge,
    .lang-pill {
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        background: var(--color-accent-light);
        color: var(--color-accent);
        font-weight: 700;
    }
    .lang-pill {
        background: transparent;
        border: 1px solid var(--color-accent);
        font-size: 0.75rem;
    }

    @media (max-width: 720px) {
        .blog-post-card {
            flex-direction: column-reverse;
            gap: 1.5rem;
            padding-bottom: 2rem;
        }
        .blog-thumb {
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
            box-shadow: var(--shadow-sm);
        }
        .blog-content {
            padding-right: 0;
        }
        .blog-title {
            font-size: 1.5rem;
        }
    }
</style>
