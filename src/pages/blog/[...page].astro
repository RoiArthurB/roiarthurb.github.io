---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
    const posts = await getPublishedPosts();

    const pageSize = 4;
    const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
    const paths = [];

    for (let i = 1; i <= totalPages; i++) {
        paths.push({
            params: { page: i === 1 ? undefined : String(i) },
            props: {
                posts: posts.slice((i - 1) * pageSize, i * pageSize),
                currentPage: i,
                totalPages,
                nextPage: i < totalPages ? i + 1 : null,
                prevPage: i > 1 ? i - 1 : null,
            },
        });
    }

    return paths;
}

const { posts, currentPage, totalPages, nextPage, prevPage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            .blog-list {
                display: flex;
                flex-direction: column;
                gap: 3rem;
                margin-top: 3rem;
            }
        </style>
	</head>
	<body>
		<Header />
		<main>
			<h1>The Notebook</h1>
            <p style="margin-bottom: 2rem; max-width: 700px; color: var(--color-text-muted);">
                A working log of testing, tinkering, occasional detours and everything I broke trying.
            </p>

            <div class="blog-list">
                {
                    posts.map((post) => (
                        <PostCard post={post} />
                    ))
                }

                {posts.length === 0 && (
                    <p style="text-align: center; color: var(--color-text-muted); font-size: 1.25rem;">
                        Coming soon...
                    </p>
                )}
            </div>

            {totalPages > 1 && (
                <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 3rem;">
                    {prevPage ? (
                        <a href={url(prevPage === 1 ? '/blog' : `/blog/${prevPage}`)} style="padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 8px; text-decoration: none; color: var(--color-text-main); font-weight: 500;">&larr; Previous</a>
                    ) : (
                        <span style="padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-text-muted); opacity: 0.5; cursor: not-allowed; font-weight: 500;">&larr; Previous</span>
                    )}

                    <span style="display: flex; align-items: center; font-weight: 600; color: var(--color-text-muted);">
                        Page {currentPage} of {totalPages}
                    </span>

                    {nextPage ? (
                        <a href={url(`/blog/${nextPage}`)} style="padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 8px; text-decoration: none; color: var(--color-text-main); font-weight: 500;">Next &rarr;</a>
                    ) : (
                        <span style="padding: 0.5rem 1rem; border: 1px solid var(--color-border); border-radius: 8px; color: var(--color-text-muted); opacity: 0.5; cursor: not-allowed; font-weight: 500;">Next &rarr;</span>
                    )}
                </div>
            )}
		</main>
		<Footer />
	</body>
</html>
