---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Image } from 'astro:assets';
import bibFileRaw from '../data/publications.bib?raw';
import { type Author, formatAuthor, parsePublications } from '../utils/bibtex';
import { url } from '../utils/paths';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 3);

const publications = parsePublications(bibFileRaw).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 4rem;
				padding: 4rem 0;
				margin-bottom: 2rem;
			}
			.hero-content { flex: 3; }
			.hero-image { 
				flex: 2; 
				text-align: center;
                position: relative;
			}
			.hero-image img {
				width: 280px;
				height: 280px;
				object-fit: cover;
				border-radius: 50%;
				border: 6px solid var(--color-bg);
				box-shadow: 0 0 0 1px var(--color-border), var(--shadow-lg);
			}
            
            .pub-mini-item {
                margin-bottom: 1.5rem;
                padding-bottom: 1.5rem;
                border-bottom: 1px solid var(--color-border);
            }
            .pub-mini-item:last-child { border-bottom: none; margin-bottom: 0; }
            .pub-title { font-weight: 700; color: var(--color-text-main); display: block; margin-bottom: 0.25rem; font-family: var(--font-serif); font-size: 1.1rem; }
            .pub-meta { font-size: 0.9rem; color: var(--color-text-muted); }

			.hero-buttons {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			@media (max-width: 768px) {
				.hero { flex-direction: column-reverse; text-align: center; padding: 2rem 0; gap: 2rem; }
                .hero-image img { width: 200px; height: 200px; }
                .hero-buttons { justify-content: center; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-content">
					<h1 style="margin-bottom: 0.5rem; font-size: 3rem;">{SITE_TITLE}</h1>
					<h2 style="font-weight: 400; color: var(--color-text-muted); margin-bottom: 1.5rem; font-family: var(--font-sans); text-transform: uppercase; letter-spacing: 0.05em; font-size: 1rem; border-bottom: none; padding-bottom: 0; display: block; margin-top: 0;">
						Computer Science Ph.D.<br/>
						IT Geek
					</h2>
					<p style="font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
						Welcome to my academic portfolio. I work on <strong>Agent-based modeling</strong> and <strong>simulation</strong> to understand complex systems.<br/>My current work bridges scientific simulation and immersive technologies.
					</p>
					<div class="hero-buttons">
						<a href={url('/publications')} class="btn">View Publications</a>
						<a href={url('/projects')} class="btn btn-outline">Current Projects</a>
					</div>
				</div>
				<div class="hero-image">
					<Image src={url('/brugiere.webp')} width={280} height={280} alt="Professor Portrait" loading="eager" fetchpriority="high" decoding="async" />
				</div>
			</section>

			<hr style="margin: 3rem 0; border-top: 1px solid var(--color-border);" />

			<div class="grid-2" style="gap: 4rem; margin-top: 0;">
                <section>
                    <h2 style="margin-top: 0;">Latest Publications</h2>
                    <div class="publication-list">
                        {publications.length > 0 ? publications.map((pub) => (
                            <div class="pub-mini-item">
                                <span class="pub-title">{pub.fields.title.replace(/[{}]/g, '')}</span>
                                <div class="pub-meta">
                                    {pub.authors.map(a => formatAuthor(a)).join(', ')}
                                    <br/>
                                    <span style="font-style: italic; color: var(--color-accent);">
                                        {(pub.fields.journal || pub.fields.booktitle || pub.fields.publisher || "Preprint").replace(/[{}]/g, '')}
                                    </span>
                                    {pub.fields.year && <span>, {pub.fields.year}</span>}
                                </div>
                            </div>
                        )) : <p>No publications found.</p>}
                    </div>
                    <div style="margin-top: 1.5rem;">
                        <a href={url('/publications')} style="font-weight: 600;">View Full List &rarr;</a>
                    </div>
                </section>

                <section>
                    <h2 style="margin-top: 0;">Lab News</h2>
                    <ul style="list-style: none; padding: 0;">
                        {posts.map((post) => (
                            <li style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px dashed var(--color-border);">
                                <a href={url(`/blog/${post.id}/`)} style="display: block; font-family: var(--font-serif); font-size: 1.1rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.25rem;">
                                    {post.data.title}
                                </a>
                                <small style="color: var(--color-text-muted); text-transform: uppercase; font-size: 0.8rem;">
                                    {post.data.pubDate.toLocaleDateString('en-us', {
                                        year: 'numeric',
                                        month: 'short',
                                        day: 'numeric',
                                    })}
                                </small>
                            </li>
                        ))}
                    </ul>
                    <a href={url('/blog')} style="font-weight: 600;">View Blog &rarr;</a>
                </section>
            </div>
		</main>
		<Footer />
	</body>
</html>
